+decodeConwayTxBodyRaw =
+  decodeMapLenOrIndef >>= \case
+    Just len -> decodeConwayTxBodyRawDefinite len basicConwayTxBodyRaw 0
+    Nothing -> decodeConwayTxBodyRawIndefinite basicConwayTxBodyRaw 0
